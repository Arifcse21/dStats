# dStats settings. Copy to .env and edit:  cp .env.example .env
# Used by docker-compose.yml (Docker Compose and Podman Compose) and by dStats.server
# when started from this directory. Every setting is optional.

# ---------------------------------------------------------------------------
# Login
# ---------------------------------------------------------------------------
# Set all three to require a login. Needed before opening dStats to the network.
# Changing the username or password takes effect on restart and revokes the old ones.
# After 5 failed logins, an address is locked out for 5 minutes.
USE_AUTH=false
AUTH_USERNAME=
AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Where dStats is reachable
# ---------------------------------------------------------------------------
# Compose only: host address and port the container is published on.
# 127.0.0.1 = this machine only. 0.0.0.0 = every interface (enable the login first).
DSTATS_BIND=127.0.0.1
DSTATS_PUBLISHED_PORT=2743

# dStats.server only (outside containers): interface and port to listen on.
# Default: 127.0.0.1 without login, 0.0.0.0 with login. The image always uses 0.0.0.0.
# DSTATS_HOST=127.0.0.1
# DSTATS_PORT=2743

# Host names dStats answers to (comma-separated). Default: * (any).
# dStats.server without login defaults to localhost names only.
# ALLOWED_HOSTS=stats.example.com,192.168.1.10

# ---------------------------------------------------------------------------
# Behind an HTTPS reverse proxy
# ---------------------------------------------------------------------------
# The public URL(s), so logins pass CSRF checks: https://stats.example.com
# CSRF_TRUSTED_ORIGINS=https://stats.example.com
# Send cookies over HTTPS only
# SECURE_COOKIES=true

# ---------------------------------------------------------------------------
# Container engines
# ---------------------------------------------------------------------------
# dStats.server only: docker (default), podman, or docker,podman.
# With Compose, the --profile you choose sets this.
# DSTATS_ENGINE=docker

# Compose only: host sockets to mount into the container.
# Docker:                 /var/run/docker.sock
# Podman rootless:        /run/user/<your uid>/podman/podman.sock   (id -u shows your uid)
# Podman rootful:         /run/podman/podman.sock
DOCKER_SOCKET=/var/run/docker.sock
PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# dStats.server only: other engine addresses (also tcp:// or ssh://).
# Default Docker: unix:///var/run/docker.sock
# Default Podman: $XDG_RUNTIME_DIR/podman/podman.sock, then /run/podman/podman.sock
# DOCKER_HOST=unix:///var/run/docker.sock
# CONTAINER_HOST=unix:///run/user/1000/podman/podman.sock

# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------
# Compose only: image to run. Use with --build to name your own build.
# DSTATS_IMAGE=arifcse21/dstats:latest

# Keeps users logged in across restarts. Default: a new random key each start.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=

# Django debug pages. Development only; never on a reachable server.
DEBUG=false
